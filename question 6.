using System;

public record Student(
    int RollNumber,
    string Name,
    string Course,
    int Semester
);

class Program
{
    static void Main()
    {
        // Creating two students with identical data
        Student student1 = new Student(101, "Abhay", "BCA", 4);
        Student student2 = new Student(101, "Abhay", "BCA", 4);

        // Display student details
        Console.WriteLine("Student 1: " + student1);
        Console.WriteLine("Student 2: " + student2);

        // Comparing students
        Console.WriteLine("\nAre both students equal?");
        Console.WriteLine(student1 == student2);
    }
}
