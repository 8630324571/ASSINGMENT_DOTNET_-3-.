using System;

class University
{
    // Nested Department class
    public class Department
    {
        // Data members
        public string DepartmentName { get; set; }
        public string HODName { get; set; }
        public int FacultyMembers { get; set; }

        // Constructor
        public Department(string departmentName, string hodName, int facultyMembers)
        {
            DepartmentName = departmentName;
            HODName = hodName;
            FacultyMembers = facultyMembers;
        }

        // Display department details
        public void DisplayDetails()
        {
            Console.WriteLine("Department Name: " + DepartmentName);
            Console.WriteLine("HOD Name: " + HODName);
            Console.WriteLine("Faculty Members: " + FacultyMembers);
        }
    }
}

class Program
{
    static void Main()
    {
        // Accessing nested Department class
        University.Department department =
            new University.Department("Computer Science", "Dr. Sharma", 25);

        Console.WriteLine("--- Department Details ---");

        department.DisplayDetails();
    }
}
